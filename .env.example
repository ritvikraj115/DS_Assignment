# Local persistent state
INGESTION_DATA_DIR=data
FAISS_INDEX_PATH=data/index.faiss
SQLITE_PATH=data/metadata.sqlite3

# Optional MongoDB metadata backend. Leave unset to use SQLite.
# MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=technical_docs

# Embeddings and structure-aware chunking
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
INGESTION_REQUEST_TIMEOUT=20
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Gemini models are configured independently for drafting and judging
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TIMEOUT_MS=30000
GENERATION_MODEL=gemini-3.1-flash-lite
GENERATION_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
JUDGE_MODEL=gemini-3.6-flash
JUDGE_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
RETRIEVAL_TOP_K=5
MAX_RETRIEVAL_RETRIES=2
MINIMUM_DIMENSION_SCORE=70
MINIMUM_OVERALL_SCORE=75
MAX_HISTORY_TURNS=8
